[Unit]
Description=TF Pi Serial Port page (WebSocket to the Amiga's Pi serial port)
Wants=network-online.target
After=network-online.target

[Service]
Environment=PYTHONPATH=/opt/tfpi/lib
WorkingDirectory=/opt/tfpi/lib
ExecStart=/usr/bin/python3 -m tfpi.serialws
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
