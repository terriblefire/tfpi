     ProgAlgXC95X alg(jtag, size);
@@ -1382,6 +1390,11 @@ int programXC95X(Jtag &jtag, unsigned long id, int argc, char **args,
             fprintf(stderr, "%s: unknown action '%c'\n", args[0], given);
             return 1;
         }
+        if (override_protect && !erase && tolower(given) != 'w')
