@@ -1432,9 +1445,14 @@ int programXC95X(Jtag &jtag, unsigned long id, int argc, char **args,
         }
     }
 
+    if (override_protect && !erase && argc == 0)
+    {
+        fprintf(stderr, "-O only goes with an erase (-e or a write)\n");
